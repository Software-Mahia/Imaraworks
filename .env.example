# Copy to .env and adjust. Never commit .env (it is gitignored).
#
# Settings and deployment variables are documented in docs/ARCHITECTURE.md,
# and the rules live in imaraworks/env.py. Docker Compose reads this file
# automatically.

# manage.py defaults to the dev settings. Set it explicitly for gunicorn,
# which (through wsgi.py) defaults to the prod settings.
DJANGO_SETTINGS_MODULE=imaraworks.settings.dev

# Hosts the app will answer for. Local machine only by default.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local SQLite path on the mounted volume (see docker-compose.yml).
DJANGO_DB_PATH=/app/data/db.sqlite3

# --- Deployed demo only (prod settings) -------------------------------------
# DJANGO_SECRET_KEY: required, kept out of git. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=
#
# DATABASE_URL: required, e.g. postgres://user:password@host:5432/name.
# DATABASE_URL=
#
# Password seed_users gives the demo accounts when DEBUG is off:
# SEED_USER_PASSWORD=
#
# Optional, defaults to 3600:
# DJANGO_HSTS_SECONDS=3600
